# =============================================================================
# Production .env template for rishan.dev
# Copy this to .env on the server and fill in the real values
# =============================================================================

APP_NAME="Rishan Dev"
APP_ENV=production
APP_KEY=                              # Run: php artisan key:generate
APP_DEBUG=false
APP_URL=https://rishan.dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database ----------------------------------------------------------------
DB_CONNECTION=sqlite

# --- Session -----------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=rishan.dev
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Services ----------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail (Google Workspace SMTP) -------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=rishan-tk@rishan.dev
MAIL_PASSWORD=                        # Google Workspace App Password (16 chars, no spaces)
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="rishan-tk@rishan.dev"
MAIL_FROM_NAME="${APP_NAME}"

# --- Vite --------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
